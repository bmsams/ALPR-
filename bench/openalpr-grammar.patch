+
+  // Mod C: Tesseract confuses glyph pairs whose only reliable disambiguator is
+  // whether the grammar wants a letter or a digit at that position. When no
+  // candidate matched a pattern, try flipping confusable characters in the
+  // top candidates until one fits, and add it with a penalized score.
+  static const char* CONFUSABLE_PAIRS[][2] = {
+    {"0","O"}, {"O","0"}, {"1","I"}, {"I","1"}, {"2","Z"}, {"Z","2"}, {"5","S"}, {"S","5"},
+    {"8","B"}, {"B","8"}, {"4","A"}, {"A","4"}, {"6","G"}, {"G","6"}, {"0","D"}, {"D","0"},
+    {"0","Q"}, {"Q","0"}, {"7","T"}, {"T","7"}, {"1","L"}, {"L","1"}
+  };
+
+  void PostProcess::repairConfusables(string templateregion, int topn)
+  {
+    const float FLIP_PENALTY = 0.93f;
+    const int MAX_FLIPS = 3;
+    vector<PPResult> repaired;
+    unsigned int limit = allPossibilities.size() < (unsigned int) topn ? allPossibilities.size() : topn;
+    for (unsigned int c = 0; c < limit; c++)
+    {
+      string base = allPossibilities[c].letters;
+      if (base.find('\n') != string::npos || allPossibilities[c].matchesTemplate)
+        continue;
+      // breadth-first over flip counts so the fewest-flip fix wins
+      set<string> seen; seen.insert(base);
+      vector<string> frontier; frontier.push_back(base);
+      bool done = false;
+      for (int depth = 1; depth <= MAX_FLIPS && !done; depth++)
+      {
+        vector<string> next;
+        for (unsigned int f = 0; f < frontier.size(); f++)
+        {
+          for (unsigned int pos = 0; pos < frontier[f].size(); pos++)
+          {
+            for (unsigned int k = 0; k < sizeof(CONFUSABLE_PAIRS)/sizeof(CONFUSABLE_PAIRS[0]); k++)
+            {
+              if (frontier[f][pos] != CONFUSABLE_PAIRS[k][0][0])
+                continue;
+              string cand = frontier[f];
+              cand[pos] = CONFUSABLE_PAIRS[k][1][0];
+              if (seen.count(cand))
+                continue;
+              seen.insert(cand);
+              if (allPossibilitiesLetters.count(cand))
+                continue;
+              if (matchesAnyRule(templateregion, cand))
+              {
+                PPResult r = allPossibilities[c];
+                r.letters = cand;
+                r.matchesTemplate = true;
+                r.totalscore = allPossibilities[c].totalscore;
+                for (int d = 0; d < depth; d++) r.totalscore *= FLIP_PENALTY;
+                repaired.push_back(r);
+                allPossibilitiesLetters.insert(cand);
+                done = true;
+              }
+              next.push_back(cand);
+            }
+          }
+        }
+        frontier = next;
+      }
+    }
+    if (repaired.empty())
+      return;
+    allPossibilities.insert(allPossibilities.end(), repaired.begin(), repaired.end());
+    std::stable_sort(allPossibilities.begin(), allPossibilities.end(), ppResultCompare);
   }
 
