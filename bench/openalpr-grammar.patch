+  bool PostProcess::matchesAnyRule(string templateregion, string text)
+  {
+    vector<RegexRule*>& regionRules = rules[templateregion];
+    for (unsigned int i = 0; i < regionRules.size(); i++)
+      if (regionRules[i]->match(text))
